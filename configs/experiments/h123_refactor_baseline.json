{
  "name": "h123_refactor_baseline",
  "model": {
    "name": "Qwen/Qwen1.5-MoE-A2.7B-Chat",
    "kind": "qwen",
    "load_source": "hf",
    "torch_dtype": "auto",
    "device_map": "auto",
    "local_files_only": false,
    "trust_remote_code": false
  },
  "runtime": {
    "top_k": 4,
    "expected_routed_experts": 60,
    "expected_shared_experts": 4,
    "strict_architecture": true
  },
  "layers": [0],
  "constants": {
    "training": "../constants/constant_repo_training.json",
    "routing": "../constants/constant_repo_routing.json",
    "visualization": "../constants/constant_repo_visualization.json",
    "io": "../constants/constant_repo_io.json"
  },
  "artifacts": {
    "root_dir": "artifacts/h123_refactor_baseline",
    "manifest_path": "artifacts/h123_refactor_baseline/artifacts_manifest.json",
    "schema_version": "1.0"
  },
  "profile": {
    "enabled": true,
    "warmup_steps": 10,
    "measure_steps": 50
  },
  "calibration": {
    "source": "synthetic",
    "output_dir": "artifacts/h123_refactor_baseline/traces",
    "max_samples": 256,
    "max_length": 512,
    "batch_size": 1,
    "calibration_fraction": 0.6,
    "validation_fraction": 0.2,
    "test_fraction": 0.2,
    "seed": 123
  },
  "pilot": {
    "enabled": false
  },
  "stages": {
    "h1": {
      "enabled": true,
      "layer": 0,
      "mlp_inputs_path": "artifacts/h123_refactor_baseline/routing_inputs_layer0.pt",
      "experts_dir": "data/experts",
      "output_pairs_path": "artifacts/h123_refactor_baseline/pairs_0.pt",
      "output_diagnostics_path": "artifacts/h123_refactor_baseline/h1_diag_0.json",
      "output_merged_dir": "artifacts/h123_refactor_baseline/merged",
      "experts_source": "hf_model",
      "auto_generate_inputs_if_missing": true,
      "mode": "pair",
      "merge_method": "geometry",
      "proj_dim": 8,
      "n_inputs": 2048,
      "batch_size": 64,
      "mp_factor": 1.1,
      "cluster_count": 0,
      "geometry_rank": 64,
      "shrink_tau": 0.0
    },
    "h2": {
      "enabled": true,
      "layer": 0,
      "mode": "gate_spike",
      "output_bias_path": "artifacts/h123_refactor_baseline/h2_bias_0.pt",
      "importance_matrix_path": "",
      "importance_vector_path": "artifacts/h123_refactor_baseline/importance_vec_0.pt",
      "gate_weight_path": "artifacts/h123_refactor_baseline/gate_weight_0.pt",
      "auto_from_model": true,
      "alpha": 0.2,
      "lam": 0.001,
      "mp_factor": 1.1,
      "normalize": "maxabs",
      "scale": 0.1
    },
    "h3": {
      "enabled": true,
      "routing_probs_path": "artifacts/h123_refactor_baseline/routing_probs_0.pt",
      "output_diagnostics_path": "artifacts/h123_refactor_baseline/h3_diag_0.json",
      "auto_from_model": true,
      "tau": 0.92,
      "k_min": 1,
      "k_max": 4
    }
  }
}
