{
  "name": "h1_rmt_rank_merge_representative_campaign",
  "model": {
    "name": "Qwen/Qwen1.5-MoE-A2.7B-Chat",
    "kind": "qwen",
    "load_source": "hf",
    "torch_dtype": "auto",
    "device_map": "auto",
    "local_files_only": false,
    "trust_remote_code": false
  },
  "runtime": {
    "top_k": 4,
    "expected_routed_experts": 60,
    "expected_shared_experts": 4,
    "strict_architecture": true
  },
  "layers": [0, 11, 23],
  "constants": {
    "training": "../constants/constant_repo_training.json",
    "routing": "../constants/constant_repo_routing.json",
    "visualization": "../constants/constant_repo_visualization.json",
    "io": "../constants/constant_repo_io.json"
  },
  "artifacts": {
    "root_dir": "artifacts/h1_rmt_rank_merge_representative_campaign",
    "manifest_path": "artifacts/h1_rmt_rank_merge_representative_campaign/artifacts_manifest.json",
    "schema_version": "2.1"
  },
  "profile": {
    "enabled": true,
    "warmup_steps": 5,
    "measure_steps": 64
  },
  "calibration": {
    "source": "hf_dataset",
    "dataset_name": "wikitext",
    "dataset_config": "wikitext-2-raw-v1",
    "dataset_split": "train",
    "text_column": "text",
    "output_dir": "artifacts/h1_rmt_rank_merge_representative_campaign/traces",
    "max_samples": 768,
    "max_length": 256,
    "batch_size": 1,
    "calibration_fraction": 0.6,
    "validation_fraction": 0.2,
    "test_fraction": 0.2,
    "seed": 2026
  },
  "pilot": {
    "enabled": true,
    "layer": 0,
    "methods": ["usage_prune", "functional_cosine", "rmt_functional_usage"],
    "compression_fractions": [0.1, 0.25],
    "quality_budgets": [0.01, 0.03, 0.05],
    "seeds": [123],
    "max_eval_batches": 64,
    "require_real_traces": true,
    "candidates_per_invocation": 1,
    "max_step_seconds": 1200,
    "spectral_pairing_ranks": [1, 2, 4, 8, 16],
    "spectral_rank_policy": {
      "include_useful_rank": true,
      "include_mp_rank": true,
      "explained_variance_thresholds": [0.9, 0.95]
    },
    "merge_weighting": {
      "methods": ["functional_cosine", "rmt_functional_usage"],
      "variants": [
        {"name": "uniform", "policy": "uniform"},
        {"name": "bounded_20", "policy": "usage_bounded", "minimum_weight": 0.2},
        {"name": "functional_ridge_01", "policy": "functional_ridge", "ridge_lambda": 0.01}
      ]
    },
    "validation_selection": {
      "slice_count": 5,
      "std_penalty": 1.0,
      "max_slice_degradation": 0.05
    },
    "hybrid_pairing": {
      "rmt_weight": 0.5,
      "functional_weight": 0.35,
      "usage_weight": 0.15
    }
  },
  "multilayer": {
    "enabled": true,
    "sensitivity_layers": [0, 11, 23],
    "methods": ["usage_prune", "functional_cosine", "rmt_functional_usage"],
    "compression_fractions": [0.1, 0.25],
    "cumulative_layer_counts": [1, 3],
    "include_all_layers": true,
    "trace_refresh_modes": ["static", "adaptive"],
    "global_compression_targets": [0.05, 0.1],
    "quality_budget": 0.05,
    "max_layer_degradation": 0.05,
    "candidates_per_invocation": 1,
    "max_step_seconds": 1200,
    "include_hybrid_recipes": true,
    "protocol": {
      "replication_seeds": [2026, 2027, 2028],
      "validation_repeats": 1,
      "test_repeats": 5,
      "materialized_repeats": 10,
      "aggregation": "median"
    },
    "selection": {
      "strategy": "method_balanced",
      "per_method_per_cell": 1,
      "include_global_winners": true,
      "balance_layer_counts": true,
      "balance_refresh_modes": false,
      "max_selected": 24
    },
    "materialization": {
      "enabled": true,
      "output_dir": "artifacts/h1_rmt_rank_merge_representative_campaign/materialized",
      "selected_plan_count": 4,
      "strategy": "method_balanced",
      "save_layer_weights": true
    }
  },
  "stages": {
    "h1": {
      "enabled": true,
      "layer": 0,
      "mlp_inputs_path": "artifacts/h1_rmt_rank_merge_representative_campaign/traces/h1_calibration_inputs.pt",
      "experts_dir": "data/experts",
      "output_pairs_path": "artifacts/h1_rmt_rank_merge_representative_campaign/pairs_0.pt",
      "output_diagnostics_path": "artifacts/h1_rmt_rank_merge_representative_campaign/h1_diag_0.json",
      "output_merged_dir": "artifacts/h1_rmt_rank_merge_representative_campaign/merged",
      "experts_source": "hf_model",
      "auto_generate_inputs_if_missing": false,
      "mode": "pair",
      "merge_method": "geometry",
      "proj_dim": 8,
      "n_inputs": 8192,
      "batch_size": 64,
      "mp_factor": 1.1,
      "cluster_count": 0,
      "geometry_rank": 64,
      "shrink_tau": 0.0,
      "null_trials": 32,
      "bootstrap_trials": 32,
      "null_quantile": 0.95,
      "stability_max_angle_deg": 30.0
    },
    "h2": {
      "enabled": false,
      "layer": 0,
      "mode": "gate_spike",
      "output_bias_path": "artifacts/h1_rmt_rank_merge_representative_campaign/h2_bias_0.pt"
    },
    "h3": {
      "enabled": false,
      "routing_probs_path": "artifacts/h1_rmt_rank_merge_representative_campaign/traces/routing_probs_0.pt",
      "output_diagnostics_path": "artifacts/h1_rmt_rank_merge_representative_campaign/h3_diag_0.json",
      "auto_from_model": false,
      "tau": 0.92,
      "k_min": 1,
      "k_max": 4
    }
  }
}
