{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoE Experiment Config",
  "type": "object",
  "required": ["name", "model", "runtime", "layers", "constants", "artifacts", "stages"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "load_source": {"type": "string", "enum": ["hf", "local"]},
        "torch_dtype": {"type": "string", "enum": ["auto", "fp16", "bf16", "fp32"]},
        "device_map": {"type": "string"},
        "local_files_only": {"type": "boolean"},
        "trust_remote_code": {"type": "boolean"}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["top_k"],
      "additionalProperties": false,
      "properties": {
        "top_k": {"type": "integer", "minimum": 1},
        "expected_routed_experts": {"type": "integer", "minimum": 1},
        "expected_shared_experts": {"type": "integer", "minimum": 0},
        "strict_architecture": {"type": "boolean"}
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "constants": {
      "type": "object",
      "required": ["training", "routing", "visualization", "io"],
      "additionalProperties": false,
      "properties": {
        "training": {"type": "string", "minLength": 1},
        "routing": {"type": "string", "minLength": 1},
        "visualization": {"type": "string", "minLength": 1},
        "io": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["root_dir", "manifest_path"],
      "additionalProperties": false,
      "properties": {
        "root_dir": {"type": "string", "minLength": 1},
        "manifest_path": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "warmup_steps": {"type": "integer", "minimum": 0},
        "measure_steps": {"type": "integer", "minimum": 1}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "enum": ["artifact", "hf_dataset", "synthetic"]},
        "dataset_name": {"type": "string"},
        "dataset_config": {"type": "string"},
        "dataset_split": {"type": "string", "minLength": 1},
        "text_column": {"type": "string"},
        "output_dir": {"type": "string", "minLength": 1},
        "max_samples": {"type": "integer", "minimum": 3},
        "max_length": {"type": "integer", "minimum": 2},
        "batch_size": {"type": "integer", "minimum": 1},
        "calibration_fraction": {"type": "number", "exclusiveMinimum": 0},
        "validation_fraction": {"type": "number", "exclusiveMinimum": 0},
        "test_fraction": {"type": "number", "exclusiveMinimum": 0},
        "seed": {"type": "integer"}
      }
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "layer": {"type": "integer", "minimum": 0},
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "random_merge",
              "usage_prune",
              "usage_guided_merge",
              "functional_cosine",
              "rmt_geometry",
              "rmt_functional_usage"
            ]
          }
        },
        "compression_fractions": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
        },
        "quality_budgets": {
          "type": "array",
          "items": {"type": "number", "minimum": 0}
        },
        "seeds": {"type": "array", "items": {"type": "integer"}},
        "max_eval_batches": {"type": "integer", "minimum": 1},
        "require_real_traces": {"type": "boolean"},
        "candidates_per_invocation": {"type": "integer", "minimum": 1},
        "max_step_seconds": {"type": "number", "exclusiveMinimum": 0},
        "spectral_pairing_ranks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "spectral_rank_schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method", "compression_fraction", "rank"],
            "additionalProperties": false,
            "properties": {
              "method": {
                "type": "string",
                "enum": ["rmt_geometry", "rmt_functional_usage"]
              },
              "compression_fraction": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "rank": {"type": "integer", "minimum": 1}
            }
          }
        },
        "merge_weighting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "methods": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "random_merge",
                  "usage_guided_merge",
                  "functional_cosine",
                  "rmt_geometry",
                  "rmt_functional_usage"
                ]
              }
            },
            "variants": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "policy"],
                "additionalProperties": false,
                "properties": {
                  "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
                  "policy": {
                    "type": "string",
                    "enum": ["uniform", "usage_proportional", "usage_bounded"]
                  },
                  "minimum_weight": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 0.5
                  }
                }
              }
            }
          }
        },
        "validation_selection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slice_count": {"type": "integer", "minimum": 1},
            "std_penalty": {"type": "number", "minimum": 0},
            "max_slice_degradation": {"type": "number", "minimum": 0}
          }
        },
        "hybrid_pairing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rmt_weight": {"type": "number", "minimum": 0},
            "functional_weight": {"type": "number", "minimum": 0},
            "usage_weight": {"type": "number", "minimum": 0},
            "variants": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "rmt_weight", "functional_weight", "usage_weight"],
                "additionalProperties": false,
                "properties": {
                  "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
                  "rmt_weight": {"type": "number", "minimum": 0},
                  "functional_weight": {"type": "number", "minimum": 0},
                  "usage_weight": {"type": "number", "minimum": 0}
                }
              }
            }
          }
        }
      }
    },
    "multilayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "sensitivity_layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["usage_prune", "functional_cosine", "rmt_functional_usage"]
          }
        },
        "compression_fractions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
        },
        "cumulative_layer_counts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "include_all_layers": {"type": "boolean"},
        "trace_refresh_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["static", "adaptive"]}
        },
        "global_compression_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
        },
        "quality_budget": {"type": "number", "minimum": 0},
        "max_layer_degradation": {"type": "number", "minimum": 0},
        "candidates_per_invocation": {"type": "integer", "minimum": 1},
        "max_step_seconds": {"type": "number", "exclusiveMinimum": 0},
        "materialization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "output_dir": {"type": "string", "minLength": 1},
            "selected_plan_count": {"type": "integer", "minimum": 1},
            "save_layer_weights": {"type": "boolean"}
          }
        }
      }
    },
    "stages": {
      "type": "object",
      "required": ["h1", "h2", "h3"],
      "additionalProperties": false,
      "properties": {
        "h1": {
          "type": "object",
          "required": [
            "enabled",
            "layer",
            "mlp_inputs_path",
            "experts_dir",
            "output_pairs_path",
            "output_diagnostics_path",
            "output_merged_dir"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "layer": {"type": "integer", "minimum": 0},
            "mlp_inputs_path": {"type": "string", "minLength": 1},
            "experts_dir": {"type": "string", "minLength": 1},
            "output_pairs_path": {"type": "string", "minLength": 1},
            "output_diagnostics_path": {"type": "string", "minLength": 1},
            "output_merged_dir": {"type": "string", "minLength": 1},
            "experts_source": {"type": "string", "enum": ["saved_experts", "hf_model"]},
            "auto_generate_inputs_if_missing": {"type": "boolean"},
            "mode": {"type": "string", "enum": ["pair", "cluster"]},
            "merge_method": {"type": "string", "enum": ["baseline", "geometry"]},
            "proj_dim": {"type": "integer", "minimum": 1},
            "n_inputs": {"type": "integer", "minimum": 1},
            "batch_size": {"type": "integer", "minimum": 1},
            "mp_factor": {"type": "number", "exclusiveMinimum": 0},
            "cluster_count": {"type": "integer", "minimum": 0},
            "geometry_rank": {"type": "integer", "minimum": 1},
            "shrink_tau": {"type": "number", "minimum": 0},
            "null_trials": {"type": "integer", "minimum": 1},
            "bootstrap_trials": {"type": "integer", "minimum": 1},
            "null_quantile": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "stability_max_angle_deg": {"type": "number", "minimum": 0}
          }
        },
        "h2": {
          "type": "object",
          "required": ["enabled", "layer", "mode", "output_bias_path"],
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "layer": {"type": "integer", "minimum": 0},
            "mode": {"type": "string", "enum": ["covariance", "gate_spike"]},
            "output_bias_path": {"type": "string", "minLength": 1},
            "importance_matrix_path": {"type": "string"},
            "importance_vector_path": {"type": "string"},
            "gate_weight_path": {"type": "string"},
            "auto_from_model": {"type": "boolean"},
            "alpha": {"type": "number", "minimum": 0, "maximum": 1},
            "lam": {"type": "number", "minimum": 0},
            "mp_factor": {"type": "number", "exclusiveMinimum": 0},
            "normalize": {"type": "string", "enum": ["none", "l2", "maxabs", "sum1"]},
            "scale": {"type": "number", "minimum": 0}
          }
        },
        "h3": {
          "type": "object",
          "required": ["enabled", "routing_probs_path", "output_diagnostics_path"],
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "routing_probs_path": {"type": "string", "minLength": 1},
            "output_diagnostics_path": {"type": "string", "minLength": 1},
            "auto_from_model": {"type": "boolean"},
            "tau": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "k_min": {"type": "integer", "minimum": 1},
            "k_max": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
